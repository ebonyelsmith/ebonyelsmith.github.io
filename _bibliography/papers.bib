@article{smith2026global,
  abbr        = {L-CSS},
  title       = {From Global to Local: Hierarchical Probabilistic Verification for Reachability Learning},
  author      = {Smith, Ebonye and Deglurkar, Sampada and Li, Jingqi and Qu, Gechen and Tomlin, Claire J.},
  journal     = {IEEE Control Systems Letters},
  volume      = {10},
  pages       = {2137--2142},
  year        = {2026},
  annotation  = {Accepted for Proc. of the IEEE Conference on Decision and Control (CDC), 2026},
  pdf         = {your_paper.pdf},
  preview     = {local_verif_figs_final_92226.png},
  bibtex_show = {true},
  code        = {https://github.com/ebonyelsmith/Hierarchical_Probabilistic_Verification},
  abstract    = {Hamilton–Jacobi (HJ) reachability provides formal safety guarantees for nonlinear systems. However, it becomes computationally intractable in high-dimensional settings, motivating learning-based approximations that may introduce unsafe errors or overly optimistic safe sets. In this work, we propose a hierarchical probabilistic verification framework for reachability learning that bridges offline global certification and online local refinement. We first construct a coarse, conservative under-approximation of the reach-avoid safe set using scenario optimization, providing an efficient global probabilistic certificate. We then introduce an online local refinement module that is structurally anchored to the global certificate and recovers regions excluded by the global verification. This refinement reduces conservatism while focusing computation on critical regions of the state space. Integrated with a condition-based switching mechanism between a learned reachability policy and a model-based controller, the proposed framework improves success rates in goal-reaching tasks with safety constraints, as demonstrated in drone-racing simulation experiments.}
}

@article{deglurkar2026active,
  abbr         = {L-CSS},
  title        = {Active Calibration of Reachable Sets Using Approximate Pick-to-Learn},
  author       = {Deglurkar, Sampada and Smith, Ebonye and Li, Jingqi and Tomlin, Claire J.},
  journal      = {IEEE Control Systems Letters},
  volume       = {10},
  pages        = {1975--1980},
  year         = {2026},
  annotation   = {Accepted for Proc. of the IEEE Conference on Decision and Control (CDC), 2026},
  pdf          = {your_paper.pdf},
  preview      = {active_cover_fig.jpg},
  bibtex_show  = {true},
  code         = {https://github.com/sdeglurkar/bayes_opt_calibration},
  abstract     = {Reachability computations that rely on approximate or learned models require calibration in order to uphold confidence about their guarantees. Calibration generally involves sampling scenarios inside the reachable set. However, producing reasonable probabilistic guarantees may require many samples, which can be costly. To remedy this, we propose that calibration of reachable sets be performed using active learning strategies. In order to produce a probabilistic guarantee on the active learning, we adapt the Pick-to-Learn algorithm, which produces generalization bounds for standard supervised learning, to the active learning setting. Our method, Approximate Pick-to-Learn, treats the process of choosing data samples as maximizing an approximate error function. Conformal prediction is used to ensure that the approximate error is close to the true model error. We demonstrate our technique for a simulated drone racing example in which learning is used to provide an initial guess of the reachable tube. Our method requires fewer samples to calibrate the model and provides more accurate sets than the baselines while also producing a novel generalization bound.}

}

@inproceedings{smith2026icl,
  abbr         = {CDC},
  title        = {How do Transformers Perform Low-Level Control In-Context?},
  author       = {Smith, Ebonye and Andrews, Aidan and Wilson, Phoenix and Frias, Alexis and Pandey, Ayush and Ranade, Gireeja},
  booktitle    = {Accepted for Proc. of the IEEE Conference on Decision and Control (CDC), 2026},
  year         = {2026},
  pdf          = {your_paper.pdf},
  preview      = {iclpaper_figs2_92326.png},
  code         = {https://github.com/ebonyelsmith/transformer_control},
  abstract     = {One of the remarkable abilities of Transformer-based neural networks is in-context learning. This motivates us to think about “in-context” control. Can we control a system knowing only (1) that it belongs to a particular family of systems and (2) some data on system evolution (provided as the context trajectory) but no specific parameter information? Specifically, we investigate the ability of Transformer-models to perform “in-context” control of unstable, nonlinear dynamical systems, where context consists only of the unforced system dynamics. We leverage a multi-head, GPT-2-style architecture, and we evaluate performance for two classical nonlinear systems – the cartpole system and the two-link acrobot system, where the system parameters are unknown to the Transformer. We consider a setting where trajectories from an expert controller are available at training time but not at inference time. Here, we identify training techniques that are essential to train Transformers to perform low-level control. Through an analysis over checkpoints, we show that in-context control is possible, and the learned policy performance generally improves as context increases. Furthermore, the Transformer models can generalize to stabilize systems that are out-of-distribution.}
}
